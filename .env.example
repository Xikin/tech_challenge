NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco de dados
POSTGRES_USER=oficina
POSTGRES_PASSWORD=TROQUE_POR_SENHA_SEGURA
POSTGRES_DB=oficina_db
DATABASE_URL=postgresql://oficina:TROQUE_POR_SENHA_SEGURA@localhost:5432/oficina_db

# JWT — mínimo 32 caracteres aleatórios
JWT_SECRET=TROQUE_POR_MINIMO_32_CHARS_ALEATORIOS
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# SMTP (opcional — deixe em branco para desabilitar e-mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Oficina Mecânica <noreply@oficina.com>

# CORS — origens permitidas em produção (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# SonarQube (apenas para análise local de qualidade de código)
SONAR_TOKEN=TROQUE_PELO_TOKEN_DO_SONARQUBE
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=TROQUE_POR_SENHA_SEGURA
SONAR_DB_NAME=sonarqube
