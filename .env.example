NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco de dados
# Local: docker compose sobe um Postgres. Em produção, esta URL vem do SSM
# (/oficina/<env>/db/database_url), escrita pelo Terraform de oficina-infra-db.
POSTGRES_USER=oficina
POSTGRES_PASSWORD=TROQUE_POR_SENHA_SEGURA
POSTGRES_DB=oficina_db
DATABASE_URL=postgresql://oficina:TROQUE_POR_SENHA_SEGURA@localhost:5432/oficina_db

# JWT — mínimo 32 caracteres aleatórios.
# ATENÇÃO: precisa ser IDÊNTICO ao JWT_SECRET da Lambda de autenticação por CPF
# (repositório oficina-auth-lambda). Se divergir, o token emitido lá é
# rejeitado aqui sem mensagem de erro útil.
JWT_SECRET=TROQUE_POR_MINIMO_32_CHARS_ALEATORIOS
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# SMTP (opcional — deixe em branco para desabilitar e-mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Oficina Mecânica <noreply@oficina.com>

# CORS — origens permitidas (separadas por vírgula).
# Vazio em desenvolvimento libera qualquer origem; em produção, preencha.
ALLOWED_ORIGINS=

# Observabilidade (Fase 3)
LOG_LEVEL=info
# Sem a licença, o agente New Relic fica desligado e nada é enviado.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-api

# Swagger. O entregável exige link para a documentação, por isso o default é
# ligado inclusive em produção.
SWAGGER_ENABLED=true

# SonarQube / SonarCloud (opcional — análise de qualidade no CI)
SONAR_TOKEN=
