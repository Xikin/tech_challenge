NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco de dados
# Local: docker compose sobe um Postgres. Em produção, esta URL vem do SSM
# (/oficina/<env>/db/database_url), escrita pelo Terraform de oficina-infra-db.
POSTGRES_USER=oficina
POSTGRES_PASSWORD=TROQUE_POR_SENHA_SEGURA
POSTGRES_DB=oficina_db
DATABASE_URL=postgresql://oficina:TROQUE_POR_SENHA_SEGURA@localhost:5432/oficina_db

# JWT — dois emissores, dois segredos (ver docs/adr/0011). Ambos com 32+
# caracteres aleatórios e OBRIGATORIAMENTE diferentes entre si.
#
# JWT_SECRET assina o login interno (ADMIN/FUNCIONARIO) e nunca sai desta API.
JWT_SECRET=TROQUE_POR_MINIMO_32_CHARS_ALEATORIOS
# JWT_CLIENTE_SECRET valida os tokens da Lambda de autenticação por CPF (papel
# CLIENTE). Precisa ser IDÊNTICO ao configurado na Lambda (oficina-auth-lambda).
JWT_CLIENTE_SECRET=TROQUE_POR_OUTRO_SEGREDO_DIFERENTE_32_CHARS
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# SMTP (opcional — deixe em branco para desabilitar e-mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Oficina Mecânica <noreply@oficina.com>

# CORS — origens permitidas (separadas por vírgula).
# Vazio em desenvolvimento libera qualquer origem; em produção, preencha.
ALLOWED_ORIGINS=

# Observabilidade (Fase 3)
LOG_LEVEL=info
# Sem a licença, o agente New Relic fica desligado e nada é enviado.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-api

# Swagger. O entregável exige link para a documentação, por isso o default é
# ligado inclusive em produção.
SWAGGER_ENABLED=true

# Seed (prisma/seed.ts)
# Sem SEED_ADMIN_PASSWORD, o seed gera uma senha aleatória e a exibe uma vez.
# SEED_PERMITIR_SENHA_PADRAO=true usa Admin@123 / Func@123 — apenas para o
# ambiente local e a collection Postman. NUNCA ligue em ambiente publicado.
SEED_PERMITIR_SENHA_PADRAO=true
SEED_ADMIN_PASSWORD=
SEED_FUNCIONARIO_PASSWORD=

# SonarQube / SonarCloud (opcional — análise de qualidade no CI)
SONAR_TOKEN=
